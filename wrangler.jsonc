{
  "name": "badgewars",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "no-reply@badgewars.com"
      ]
    },
    {
      "name": "OPS_EMAIL",
      "destination_address": "smorgarc@sergiotech.es"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/badges/*",
      "/b/*",
      "/terms",
      "/refunds",
      "/privacy",
      "/legal",
      "/cookies"
    ]
  },
  "vars": {
    "APP_URL": "https://badgewars.com",
    "EMAIL_AUTH_ENABLED": "false",
    "EMAIL_FROM": "no-reply@badgewars.com",
    "AUTH_PROVIDERS": "google,github",
    "DODO_PAYMENTS_ENVIRONMENT": "live_mode",
    "DODO_CHECKOUT_ENABLED": "false",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFbguuCDX9yAntxz",
    "OPS_EMAIL_TO": "smorgarc@sergiotech.es",
    "OPS_EMAIL_FROM": "support@badgewars.com",
    "CF_ACCOUNT_ID": "93d96c1211328e81e46cb2bc8af30d47",
    "MAINTENANCE_MODE": "false",
    "DODO_BUSINESS_ID": "bus_0Nq2W1t4evUWwRbmuQ0YT",
    "DODO_PRODUCT_ID_EUR": "pdt_0NqACN2zz8xE9mJa7W70K"
  },
  "kv_namespaces": [
    {
      "binding": "BADGES",
      "id": "f452a6607f9b4ce0a4050ef689873cb8"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "2,17,32,47 * * * *",
      "1-59/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "badgewars",
      "database_id": "6fb4d88f-8d52-432d-968e-0832b481eb81",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05,
    "issues": {
      "enabled": true
    }
  },
  "account_id": "93d96c1211328e81e46cb2bc8af30d47"
}
