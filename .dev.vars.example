# Copy to .dev.vars for local Worker testing; never commit real credentials.
APP_URL=http://127.0.0.1:8787
AUTH_COOKIE_SECRET=replace_with_random_value_of_at_least_32_characters
AUTH_PROVIDERS=google,github
# Enable only after Workers Paid, Email Sending DNS verification and end-to-end QA.
EMAIL_AUTH_ENABLED=false
EMAIL_FROM=no-reply@badgewars.com
PASSWORD_PEPPER=replace_with_a_separate_random_secret_of_at_least_32_characters
GOOGLE_CLIENT_ID=replace
GOOGLE_CLIENT_SECRET=replace
GITHUB_CLIENT_ID=replace
GITHUB_CLIENT_SECRET=replace
TURNSTILE_SITE_KEY=replace
TURNSTILE_SECRET_KEY=replace
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=dodo_test_replace
DODO_BUSINESS_ID=bus_replace
# Two fixed-price products: 1 BC at 100 minor units, tax exclusive, no discounts/PPP.
DODO_PRODUCT_ID_USD=pdt_replace_usd
DODO_PRODUCT_ID_EUR=pdt_replace_eur
DODO_PAYMENTS_WEBHOOK_KEY=whsec_replace
# Only a real written acceptance of the complete model enables live checkout.
DODO_LIVE_APPROVAL_REFERENCE=
# Seller identification defaults to the verified/user-provided SergioTech data
# in public/terms.js. Optional overrides: SELLER_LEGAL_NAME, SELLER_COUNTRY,
# SELLER_CITY, SELLER_ADDRESS, SELLER_SUPPORT_EMAIL, SELLER_TAX_ID.
# These are public legal details. Do not add a telephone field.
